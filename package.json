{
  "name": "pi-sticky",
  "version": "0.0.0",
  "private": true,
  "description": "pi extension: the agent pins messages for the user; they stay on screen until resolved, and the user can reply to them.",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "bun test",
    "check": "biome check src test && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.2.20"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/bun": "1.4.3",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
